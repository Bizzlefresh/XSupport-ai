# Copy to .env and change values. Never commit .env.

# --- Database (docker-compose uses these) ---
POSTGRES_USER=xsupport
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=xsupport

# --- Backend ---
ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Integrations: disabled by default. Do NOT enable without written StFX authorization. ---
TEAMDYNAMIX_ENABLED=false
TEAMDYNAMIX_READ_ONLY=true
TEAMDYNAMIX_BASE_URL=
TEAMDYNAMIX_APP_ID=
TEAMDYNAMIX_TOKEN=
EXTERNAL_LLM_ENABLED=false

# --- Demo users created by scripts/seed_database.py (random passwords printed if blank) ---
SEED_ADMIN_PASSWORD=
SEED_TECH_PASSWORD=

# --- Frontend (build-time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
